{
  "name": "lego-games",
  "version": "0.1.0",
  "private": true,
  "description": "Exact TypeScript ports of classic LEGO PC games, reverse-engineered from the original binaries and run on the player's own game files.",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "verify": "tooling verify",
    "check": "pnpm run verify && pnpm run duplicates && pnpm -r run check",
    "ci": "pnpm run verify && pnpm run duplicates && pnpm -r run ci && pnpm run format:check",
    "format": "pnpm -r run format && prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .git-hooks || true",
    "traced-constants:baseline": "tooling traced-constants-baseline",
    "duplicates": "jscpd packages",
    "differential": "sh reverse-engineering/emulator/setup.sh && pnpm --filter @lego-games/lego-racers exec vitest run differential",
    "golden-trace": "sh reverse-engineering/emulator/setup.sh && pnpm --filter @lego-games/lego-racers run golden-trace",
    "replay": "sh reverse-engineering/emulator/setup.sh && node packages/lego-racers/src/modules/session-replay/controller/replay-cli/replay-cli.ts",
    "replay:inbox": "sh reverse-engineering/emulator/setup.sh && node packages/lego-racers/src/modules/session-replay/controller/replay-inbox/replay-inbox-cli.ts",
    "export-assets": "node packages/lego-racers-export/src/modules/asset-export/controller/export-assets-command/export-assets-command.ts",
    "render-trace": "sh reverse-engineering/emulator/setup.sh && pnpm --filter @lego-games/lego-racers-web run render-trace",
    "pixel-trace": "sh reverse-engineering/emulator/setup.sh && pnpm --filter @lego-games/lego-racers-web run pixel-trace",
    "traces": "pnpm run golden-trace && pnpm run render-trace && pnpm run pixel-trace",
    "render-coverage": "sh reverse-engineering/emulator/setup.sh && pnpm --filter @lego-games/lego-racers-web run render-coverage",
    "audio-trace": "sh reverse-engineering/emulator/setup.sh && pnpm --filter @lego-games/lego-racers-web run audio-trace",
    "ldraw-fidelity": "pnpm --filter @lego-games/lego-racers-web run ldraw-fidelity",
    "dev": "pnpm --filter @lego-games/lego-racers-web run dev"
  },
  "prettier": "@lego-games/tooling/prettier",
  "devDependencies": {
    "@lego-games/tooling": "workspace:*",
    "@types/node": "^24.19.1",
    "eslint": "^10.12.0",
    "jscpd": "5.3.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
