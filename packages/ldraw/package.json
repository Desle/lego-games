{
  "name": "@lego-games/ldraw",
  "version": "0.1.0",
  "private": true,
  "description": "Generic LDraw for the LEGO game ports: the parts library, parsing and merging in a worker, plastic looks, stud-grid building maths, and the embeddable editor tools (the model viewer).",
  "type": "module",
  "exports": {
    "./building": "./src/modules/building/index.ts",
    "./editor": "./src/modules/editor/index.ts",
    "./geometry": "./src/modules/geometry/index.ts",
    "./library": "./src/modules/library/index.ts",
    "./material": "./src/modules/material/index.ts",
    "./minifig": "./src/modules/minifig/index.ts",
    "./particles": "./src/modules/particles/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "verify": "tooling verify",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run verify && pnpm run test",
    "format": "eslint --fix . && prettier --write .",
    "format:check": "prettier --check .",
    "build": "tsc -p tsconfig.build.json",
    "audit:high": "pnpm audit --audit-level high",
    "ci": "pnpm run check && pnpm run format:check && pnpm run build && pnpm run audit:high"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@lego-games/tooling": "workspace:*",
    "@types/three": "0.186.0",
    "jsdom": "30.1.1"
  }
}
