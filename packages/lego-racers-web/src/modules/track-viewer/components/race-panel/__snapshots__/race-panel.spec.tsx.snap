// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`RacePanel > renders default snapshot 1`] = `
<div>
  <section
    class="flex flex-col gap-3 text-sm"
  >
    <button
      class="rounded bg-amber-500 px-3 py-3 text-base font-semibold text-slate-900 hover:bg-amber-400 disabled:opacity-50"
      type="button"
    >
      Choose your LEGO Racers game folder
    </button>
    <p
      class="text-center text-slate-400"
    >
      The folder with LEGO.JAM and LEGORacers.exe; the files are read in your browser and never uploaded.
    </p>
    <dl
      class="grid grid-cols-[auto_1fr] gap-x-3 gap-y-1 text-xs"
    >
      <div
        class="contents"
      >
        <dt
          class="font-mono text-amber-300"
        >
          Left arrow
        </dt>
        <dd
          class="text-slate-300"
        >
          steer positive
        </dd>
      </div>
      <div
        class="contents"
      >
        <dt
          class="font-mono text-amber-300"
        >
          Right arrow
        </dt>
        <dd
          class="text-slate-300"
        >
          steer negative
        </dd>
      </div>
      <div
        class="contents"
      >
        <dt
          class="font-mono text-amber-300"
        >
          Up arrow
        </dt>
        <dd
          class="text-slate-300"
        >
          accelerate
        </dd>
      </div>
      <div
        class="contents"
      >
        <dt
          class="font-mono text-amber-300"
        >
          Down arrow
        </dt>
        <dd
          class="text-slate-300"
        >
          brake
        </dd>
      </div>
      <div
        class="contents"
      >
        <dt
          class="font-mono text-amber-300"
        >
          Enter
        </dt>
        <dd
          class="text-slate-300"
        >
          use power up
        </dd>
      </div>
      <div
        class="contents"
      >
        <dt
          class="font-mono text-amber-300"
        >
          Right Ctrl
        </dt>
        <dd
          class="text-slate-300"
        >
          change camera
        </dd>
      </div>
      <div
        class="contents"
      >
        <dt
          class="font-mono text-amber-300"
        >
          M
        </dt>
        <dd
          class="text-slate-300"
        >
          change hud mode
        </dd>
      </div>
      <div
        class="contents"
      >
        <dt
          class="font-mono text-amber-300"
        >
          Space
        </dt>
        <dd
          class="text-slate-300"
        >
          power slide
        </dd>
      </div>
      <div
        class="contents"
      >
        <dt
          class="font-mono text-amber-300"
        >
          Right Alt
        </dt>
        <dd
          class="text-slate-300"
        >
          look behind
        </dd>
      </div>
    </dl>
    <p
      class="text-xs text-slate-400"
    >
      A gamepad steers with its first axis; buttons 1 to 7 accelerate, brake, use the power-up, change camera, change HUD, power slide and look behind.
    </p>
  </section>
</div>
`;

