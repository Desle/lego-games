// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`DevelopmentPanel > renders default snapshot 1`] = `
<div>
  <section
    class="fixed top-2 right-2 z-30 flex w-60 flex-col gap-2 rounded bg-slate-900/90 p-3 text-xs text-slate-100"
  >
    <h2
      class="font-semibold"
    >
      Developer tools (~ closes)
    </h2>
    <button
      class="rounded bg-slate-700 px-2 py-1 hover:bg-slate-600"
      type="button"
    >
      Track viewer
    </button>
    <button
      class="rounded bg-slate-700 px-2 py-1 hover:bg-slate-600"
      type="button"
    >
      Download the last session recording (F9)
    </button>
    <button
      class="rounded bg-slate-700 px-2 py-1 hover:bg-slate-600"
      type="button"
    >
      Unlock everything (rewrites the save, reloads)
    </button>
    <label
      class="flex flex-col gap-1"
    >
      Textures (reloads)
      <select
        class="rounded bg-slate-700 px-2 py-1"
      >
        <option
          value=""
        >
          Classic (original)
        </option>
        <option
          value="ultrasharp"
        >
          ultrasharp
        </option>
      </select>
    </label>
    <p
      class="text-slate-400"
    >
      Power-ups for the player: 1 cannon, 2 shield, 3 turbo, 4 oil; 5 and 6 lower and raise the level.
    </p>
    <button
      class="rounded bg-slate-700 px-2 py-1 hover:bg-slate-600"
      type="button"
    >
      Close
    </button>
  </section>
</div>
`;

exports[`DevelopmentPanel > renders the stop button while a race runs 1`] = `
