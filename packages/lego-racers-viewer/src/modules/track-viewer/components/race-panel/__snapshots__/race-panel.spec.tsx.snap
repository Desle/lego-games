exports[`RacePanel > renders a running race with a stop button 1`] = `
<div>
  <section
    class="flex flex-col gap-3 text-sm"
  >
    <button
      class="rounded bg-amber-500 px-3 py-2 font-semibold text-slate-900 hover:bg-amber-400 disabled:opacity-50"
      type="button"
    >
      Open the game (development files)
    </button>
    <label
      class="flex cursor-pointer flex-col gap-1 rounded-lg border-2 border-dashed border-slate-500 p-3 text-center hover:border-amber-400"
    >
      <span
        class="font-semibold"
      >
        Choose the game files
      </span>
      <span
        class="text-slate-400"
      >
        LEGO.JAM, LEGORacers.exe and the .tun music; they never leave your browser.
      </span>
      <input
        class="sr-only"
        multiple=""
        type="file"
      />
    </label>
    <button
      class="rounded bg-slate-700 px-2 py-1 hover:bg-slate-600"
      type="button"
    >
      Stop the race (back to the menus)
    </button>
    <dl
      class="grid grid-cols-[auto_1fr] gap-x-3 gap-y-1 text-xs"
    >
      <div
        class="contents"
      >
        <dt
          class="font-mono text-amber-300"
        >
          Left arrow
        </dt>
        <dd
          class="text-slate-300"
        >
          steer positive
        </dd>
      </div>
      <div
        class="contents"
      >
        <dt
          class="font-mono text-amber-300"
        >
          Right arrow
        </dt>
        <dd
          class="text-slate-300"
        >
          steer negative
        </dd>
      </div>
      <div
        class="contents"
      >
        <dt
          class="font-mono text-amber-300"
        >
          Up arrow
        </dt>
        <dd
          class="text-slate-300"
        >
          accelerate
        </dd>
      </div>
      <div
        class="contents"
      >
        <dt
          class="font-mono text-amber-300"
        >
          Down arrow
        </dt>
        <dd
          class="text-slate-300"
        >
          brake
        </dd>
      </div>
      <div
        class="contents"
      >
        <dt
          class="font-mono text-amber-300"
        >
          Enter
        </dt>
        <dd
          class="text-slate-300"
        >
          use power up
        </dd>
      </div>
      <div
        class="contents"
      >
        <dt
          class="font-mono text-amber-300"
        >
          Right Ctrl
        </dt>
        <dd
          class="text-slate-300"
        >
          change camera
        </dd>
      </div>
      <div
        class="contents"
      >
        <dt
          class="font-mono text-amber-300"
        >
          M
        </dt>
        <dd
          class="text-slate-300"
        >
          change hud mode
        </dd>
      </div>
      <div
        class="contents"
      >
        <dt
          class="font-mono text-amber-300"
        >
          Space
        </dt>
        <dd
          class="text-slate-300"
        >
          power slide
        </dd>
      </div>
      <div
        class="contents"
      >
        <dt
          class="font-mono text-amber-300"
        >
          Right Alt
        </dt>
        <dd
          class="text-slate-300"
        >
          look behind
        </dd>
      </div>
    </dl>
    <p
      class="text-xs text-slate-400"
    >
      A gamepad steers with its first axis; buttons 1 to 7 accelerate, brake, use the power-up, change camera, change HUD, power slide and look behind.
    </p>
  </section>
</div>
`;

