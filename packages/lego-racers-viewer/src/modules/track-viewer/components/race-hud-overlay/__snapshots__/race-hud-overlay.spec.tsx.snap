// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`RaceHudOverlay > renders default snapshot 1`] = `
<div>
  <div
    class="pointer-events-none absolute inset-0"
    data-testid="race-hud"
  >
    <canvas
      aria-hidden="true"
      class="absolute inset-0"
      height="600"
      width="800"
    />
    <span
      class="absolute right-2 bottom-2 rounded bg-black/60 px-2 py-1 text-xs text-slate-200"
    >
      racing
    </span>
  </div>
</div>
`;

exports[`RaceHudOverlay > renders the countdown numeral as accessible text beside the font canvas 1`] = `
<div>
  <div
    class="pointer-events-none absolute inset-0"
    data-testid="race-hud"
  >
    <canvas
      aria-hidden="true"
      class="absolute inset-0"
      height="600"
      width="800"
    />
    <span
      class="sr-only"
    >
      3
    </span>
    <span
      class="absolute right-2 bottom-2 rounded bg-black/60 px-2 py-1 text-xs text-slate-200"
    >
      countdown
    </span>
  </div>
</div>
`;

exports[`RaceHudOverlay > renders the held power-up holder and icon from the image database urls 1`] = `
<div>
  <div
    class="pointer-events-none absolute inset-0"
    data-testid="race-hud"
  >
    <canvas
      aria-hidden="true"
      class="absolute inset-0"
      height="600"
      width="800"
    />
    <img
      alt="HOLDER"
      class="absolute max-w-none"
      src="data:image/png;base64,AA=="
      style="left: 20px; top: 500px; width: 64px; height: 64px;"
    />
    <img
      alt="CANNON"
      class="absolute max-w-none"
      src="data:image/png;base64,BB=="
      style="left: 36px; top: 520px; width: 32px; height: 32px;"
    />
    <span
      class="absolute right-2 bottom-2 rounded bg-black/60 px-2 py-1 text-xs text-slate-200"
    >
      racing
    </span>
  </div>
</div>
`;

